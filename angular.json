{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "yarn",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "uirouter-angular": {
      "projectType": "library",
      "root": "./",
      "sourceRoot": "./src",
      "prefix": "ui",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "./tsconfig.json"
            },
            "development": {
              "tsConfig": "./tsconfig.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
